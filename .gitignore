# macOS
.DS_Store
._*

# Réglages locaux d'éditeur
.claude/settings.local.json
.vscode/
.idea/

# Journaux et fichiers temporaires
*.log
*.tmp
*~

# Secrets (aucun aujourd'hui, par précaution)
.env
.env.*
*.key
*.pem

# Caches Python locaux
__pycache__/
*.pyc

# Sauvegardes et clés : jamais dans Git (voir docs/backup/BACKUP-STRATEGY.md)
sauvegardes/
*.age
*.dump
*.key
age-identity*
*.sql.gz
journal.jsonl

# Préproduction : la configuration locale et les scripts assemblés se régénèrent (docs/production/ENVIRONNEMENTS.md)
outils/staging/config-staging.local.json
outils/staging/sortie/

# L'application de bureau (bureau/) : ce qui se fabrique à la construction
bureau/site/
bureau/node_modules/
bureau/src-tauri/target/
bureau/src-tauri/gen/
bureau/src-tauri/icons/
